# The Space the route handler proxies to.
VOXAE_SPACE_URL=https://nhibuilds-voxae.hf.space

# Read-scoped Hugging Face token. Server-side only, never sent to the browser.
# Without it every visitor draws on the same anonymous ZeroGPU quota, which is
# a few minutes per day in total and runs out immediately under any real use.
HF_TOKEN=

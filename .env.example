# --- VLM grounding backend ---
VOXAE_VLM_API_KEY=
VOXAE_VLM_BASE_URL=https://openrouter.ai/api/v1
# Any vision-capable model on the endpoint above; hosted ids get delisted, so
# this is configuration rather than an architectural commitment.
VOXAE_VLM_MODEL=qwen/qwen3.7-plus

# --- Dataset query generation (any OpenAI-compatible model id) ---
VOXAE_QGEN_MODEL=anthropic/claude-sonnet-5

# --- Trained bridge (demo serves it when a checkpoint is set) ---
VOXAE_CHECKPOINT_DIR=
VOXAE_TRAINED_BACKBONE_ID=Qwen/Qwen2-VL-2B-Instruct

# --- Hugging Face ---
HF_TOKEN=

# --- Experiment tracking ---
WANDB_API_KEY=
